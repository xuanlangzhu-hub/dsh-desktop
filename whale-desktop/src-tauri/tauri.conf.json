{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whale Harness Desktop",
  "version": "0.2.0",
  "identifier": "ai.deepseek.harness.whale",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Whale Harness Desktop",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Light",
        "backgroundColor": "#eaf4fb"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../runtime/node/": "runtime/node/",
      "../runtime/dsh/": "runtime/dsh/",
      "../../dsh-whale-mist/package.json": "runtime/theme/dsh-whale-mist/package.json",
      "../../dsh-whale-mist/cordis.patch.yml": "runtime/theme/dsh-whale-mist/cordis.patch.yml",
      "../../dsh-whale-mist/src/": "runtime/theme/dsh-whale-mist/src/",
      "../../dsh-whale-mist/README.md": "runtime/theme/dsh-whale-mist/README.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
