{
  "name": "whale-harness-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Tauri desktop shell for DeepSeek Harness and Whale Mist",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "prepare:runtime": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime.ps1",
    "build": "tauri build",
    "portable": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "qa:vision-bridge": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File qa/vision-bridge-regression.ps1",
    "check": "node --check dist/app.js && npm run qa:vision-bridge && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
